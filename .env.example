# -----------------------------------------------------------------------
# Financial Document Analyzer — Environment Variables
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------

# ── LLM Provider (set at least one) ────────────────────────────────────
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...

# Model to use (defaults shown)
# LLM_MODEL=gpt-4o-mini           # for OpenAI
# LLM_MODEL=gemini/gemini-1.5-flash  # for Google

# ── Web Search (optional — SerperDev for real-time market data) ─────────
SERPER_API_KEY=...

# ── Database (optional — defaults to local SQLite) ───────────────────────
# DATABASE_URL=sqlite:///./financial_analyzer.db
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_analyzer

# ── Redis / Celery Queue (optional — falls back to sync if not set) ──────
# REDIS_URL=redis://localhost:6379/0
